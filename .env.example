# MongoDB Atlas Model API key (ai.mongodb.com)
# Copy this file to .env and replace the placeholders:
#   cp .env.example .env
VOYAGE_API_KEY=your-model-api-key-here

# MongoDB Atlas cluster
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.etgs2.mongodb.net/
MONGODB_DB=mydatabase
MONGODB_COLLECTION=mycollection
MONGODB_COLLECTION_AUTO=mycollection_auto
